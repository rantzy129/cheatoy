NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase secret key for privileged admin API operations. Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted. Never prefix either with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your_secret_key

# Server-Side Admin Authentication (Never exposed to client)
ADMIN_PIN=your-admin-pin
ADMIN_SECRET_KEY=your-secret-signing-key
LICENSE_SIGNING_SECRET=your-independent-license-signing-secret

# Discord Webhook Gateways
DISCORD_ORDER_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_USER_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_USER_LIST_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_CURRENT_USERS_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_CURRENT_USERS_MESSAGE_ID=your-message-id-to-edit

# Discord Bot Integration (Auto-Role & DM Dispatch)
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-server-id
DISCORD_VIP_ROLE_ID=your-vip-role-id
